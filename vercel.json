{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "fluid": true,
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "includeFiles": "{website/model/**,website/data/**}",
      "excludeFiles": "{docs/**,website/tests/**,website/tools/vision-assets/**,phishing-detection/**,**/*.test.py,**/*.test.mjs}"
    }
  },
  "env": {
    "APP_ENV": "production",
    "PHISHGUARD_DEPLOYMENT_PROFILE": "vercel-free",
    "VERIFICATION_MODE": "lite",
    "VERIFICATION_WORKERS": "4",
    "CONTENT_MODEL_ENABLED": "true",
    "CONTENT_MODEL_ARTIFACT": "website/model/content_model_artifact.pkl",
    "CONTENT_MODEL_ARTIFACT_SHA256": "a0a503a0cd6122e722933add91f49cc72e3fa74abaf1129c4df3fe0450401746",
    "RDAP_LOOKUPS": "true",
    "RATE_LIMIT_PER_MINUTE": "10",
    "RATE_LIMIT_BUCKET_CAPACITY": "1024",
    "MAX_REQUEST_BYTES": "65536",
    "ALLOWED_HOSTS": "*.vercel.app,localhost,127.0.0.1,testserver"
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/static/:path((?!vision-worker\\.mjs$|vendor/vision/worker\\.min\\.js$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/static/vision-worker.mjs",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; worker-src 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/static/vendor/vision/worker.min.js",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; worker-src 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": {
            "re": "^.+$"
          }
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
